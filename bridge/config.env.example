# =======================================================
# Configurazione Bridge Stampante Epson TM - Pit Stop 2.0
# Rinomina questo file in "config.env" nella stessa cartella
# =======================================================

# URL del server in cloud (su Vercel) o locale per test
SERVER_URL="https://comande.pitstop2.it"

# Deve coincidere esattamente con BRIDGE_TOKEN impostato su Vercel
BRIDGE_TOKEN="cambia-questo-token-bridge-pitstop2"

# Modalita di stampa:
# "tcp"     -> stampa diretta di rete su porta 9100 (consigliato per Epson TM Ethernet/Wi-Fi)
# "spooler" -> usa la stampante condivisa del sistema operativo (USB/Windows/Mac CUPS)
PRINT_MODE="tcp"

# Indirizzo IP della stampante principale (Cucina) e porta RAW (default 9100)
PRINTER_KITCHEN_HOST="192.168.1.100"
PRINTER_PORT="9100"

# Opzionali: se hai stampanti dedicate per Bar e Cassa inserisci i loro IP,
# altrimenti lasciale vuote per stampare tutto sulla stampante principale
PRINTER_BAR_HOST=""
PRINTER_CASHIER_HOST=""

# Nome della stampante di sistema (usato solo se PRINT_MODE="spooler")
# Su Windows condividere la stampante come "EPSON_TM"; su Mac usare il nome coda CUPS
SYSTEM_PRINTER_NAME="EPSON_TM"

# Frequenza di controllo coda stampa in millisecondi (2500 = ogni 2,5 secondi)
POLL_INTERVAL_MS="2500"
